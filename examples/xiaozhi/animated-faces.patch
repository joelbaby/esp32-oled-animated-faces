+
+void OledDisplay::UpdateAnimatedFaces() {
+    const uint32_t now = lv_tick_get();
+    if (faces_preview_duration_ && now - faces_preview_started_ >= faces_preview_duration_) {
+        faces_preview_duration_ = 0;
+        faces_player_.Select(faces_live_emotion_.c_str(), now);
+    }
+    if (faces_player_.Draw(now, faces_buffer_ + 8, animated_faces::FrameBytes))
+        lv_obj_invalidate(faces_canvas_);
+}
+
+bool OledDisplay::PreviewAnimatedExpression(const char* expression) {
+    DisplayLockGuard lock(this);
+    if (!lock || !faces_canvas_ || !expression) return false;
+    const unsigned id = OttoPlayer::Find(expression);
+    if (id == 0 && std::strcmp(expression, "neutral")) return false;
+    faces_preview_started_ = lv_tick_get();
+    faces_preview_duration_ = 3000;
+    faces_player_.Select(expression, faces_preview_started_, true);
+    return true;
+}
+
+void OledDisplay::SetAnimatedFacesVisible(bool visible) {
+    DisplayLockGuard lock(this);
+    if (!lock || !faces_canvas_) return;
+    faces_visible_ = visible;
+    faces_player_.SetVisible(visible && !faces_power_save_, lv_tick_get());
+    if (visible) {
+        lv_obj_remove_flag(faces_canvas_, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_add_flag(content_, LV_OBJ_FLAG_HIDDEN);
+        if (!faces_power_save_) lv_timer_resume(faces_timer_);
+    } else {
+        lv_obj_add_flag(faces_canvas_, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_remove_flag(content_, LV_OBJ_FLAG_HIDDEN);
+        lv_timer_pause(faces_timer_);
+    }
+}
